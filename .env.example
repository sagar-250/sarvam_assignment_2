# All of these are optional - the primary review path needs none of them.
# The default formatter is deterministic/rule-based (see backend/formatter.py)
# and requires no credentials.

# SQLite database file path (default: data/kivi_memory.db)
# KIVI_DB_PATH=data/kivi_memory.db

# Evidence / confidence lifecycle thresholds (defaults shown)
# KIVI_EVIDENCE_THRESHOLD=3
# KIVI_MIN_EVIDENCE_ACTIVE=2
# KIVI_MIN_CONFIDENCE_ACTIVE=0.6

# Retrieval tuning (defaults shown)
# KIVI_MAX_SPAN_TOKENS=3
# KIVI_CONTEXT_WINDOW=4

# --- Optional, NOT used by the primary review path ---
# An LLM-backed formatter extension point (backend/llm_formatter.py) exists
# but is unimplemented and OFF by default. Only relevant if you choose to
# wire in your own LLM formatting step.
# KIVI_USE_LLM_FORMATTER=false
# KIVI_LLM_API_KEY=

# --- Optional, used by tools/generate_entities.py (an offline eval-authoring
# script), backend/grouping.py, AND backend/entity_extraction.py (both opt-in
# features, see below) - never required to run, review, or evaluate the
# application itself. Defaults to Mistral; set KIVI_LLM_PROVIDER=nvidia to
# use NVIDIA NIM instead.
# MISTRAL_KEY=
# NVIDIA_KEY=
# KIVI_LLM_PROVIDER=mistral
# KIVI_LLM_MODEL=open-mistral-nemo

# --- NOT an env var - a one-time model download, see RUN.md ---
# The "Bulk Teach" UI's "Corrected text only" mode (POST /api/learn-from-
# conversations) needs NO credentials at all: backend/ner_extraction.py uses
# a free, offline spaCy model (`python -m spacy download en_core_web_sm`).
# MISTRAL_KEY/NVIDIA_KEY above are an OPTIONAL refinement on top of that, not
# a requirement - see README "Bulk-teaching from existing corrected data".

# --- Optional, NOT used by the primary review path ---
# LLM-assisted grouping of adjacent word-level corrections into one
# multi-word entity (backend/grouping.py) - mitigates the fragmentation
# limitation documented in README (e.g. "new" + "yolk sity" -> "New York
# City"). OFF by default; needs MISTRAL_KEY/NVIDIA_KEY above too. See README
# "Optional: LLM-assisted grouping for adjacent corrections".
# KIVI_LLM_GROUPING_ENABLED=false
